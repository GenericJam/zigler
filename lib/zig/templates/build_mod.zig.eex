<% _ = opts %>
const std = @import("std");

const BuildMode = enum{ nif_lib, sema };

pub fn build(b: *std.Build) void {
    const resolved_target = b.standardTargetOptions(<%=Zig.Target.for_builder()%>);
    const optimize: std.builtin.OptimizeMode = <%= render_optimize_mode(assigns) %>;
    const error_tracing = <%= @error_tracing %>;

    const mode = b.option(BuildMode, "zigler-mode", "Build either the nif library or the sema analysis module") orelse .nif_lib;

    // `nif_linkage` controls whether the produced NIF is a dynamic
    // library (default — what a host BEAM dlopens from priv/) or a
    // static archive (.a — needed when linking the NIF into an
    // embedded BEAM that doesn't have dlopen, e.g. iOS device).
    // Static-linked NIFs also need the BEAM module name to match the
    // static-NIF table entry; the caller is responsible for setting
    // that up (e.g. via `-Dnif_init_name=<name>_nif_init` plumbing on
    // the link side).
    const nif_linkage = b.option(std.builtin.LinkMode, "nif_linkage", "NIF library linkage — dynamic (host) or static (embedded/iOS)") orelse .dynamic;

    // For static-linked NIFs, BEAM's `erts_static_nif_tab[]` lookup
    // matches a symbol named `<modname>_nif_init`. Zigler emits a bare
    // `nif_init` (matches the dlopen path). When the consumer wants the
    // static-table form, they pass `-Dnif_init_alias=<name>_nif_init`
    // and we emit an additional `@export` aliasing nif_init under that
    // name. The standard `nif_init` is always kept so the dlopen path
    // also works. Empty string = no alias.
    const nif_init_alias = b.option([]const u8, "nif_init_alias", "Additional exported symbol name for nif_init (for static-NIF table linking — e.g. `<name>_nif_init`)") orelse "";

    // Thread nif_init_alias into module.zig via b.addOptions. The
    // module conditionally emits an @export with this name in addition
    // to the default `nif_init`. See module.zig.eex for the consumer.
    const build_options = b.addOptions();
    build_options.addOption([]const u8, "nif_init_alias", nif_init_alias);

    // Apple SDK root for cross-compile to iOS/macOS/tvOS/watchOS.
    // Zig's cImport-driven modules (`erl_nif`, anything using
    // @cImport) need the Apple SDK's `sys/types.h` etc. — Zig's
    // bundled libc headers don't cover Apple's Darwin extensions.
    // Set via `xcrun --show-sdk-path -sdk iphoneos` (or
    // iphonesimulator/macosx). Empty string = host build, no SDK
    // injection — the host's default include path is fine.
    const apple_sdkroot = b.option([]const u8, "apple_sdkroot", "Absolute path to an Apple SDK (iPhoneOS/iPhoneSimulator/MacOSX). Required when cross-compiling cImport-bearing modules to an Apple target.") orelse "";

    <%= for {name, _} <- @dependencies do %>
    const <%= name %> = b.dependency("<%= name %>", .{
        .target = resolved_target,
        .optimize = optimize
    });
    <% end %>

    switch (mode) {
        .nif_lib => {

            <%= Builder.render_build(BuildModule.erl_nif()) %>
            <%= Builder.render_build(BuildModule.beam()) %>
            <%= Builder.render_build(BuildModule.attributes()) %>
            <%= for extra_module <- @extra_modules, do: Builder.render_build(extra_module)%>
            <%= Builder.render_build(BuildModule.from_beam_module(assigns)) %>
            <%= Builder.render_build(BuildModule.nif_shim()) %>

            // When cross-compiling to an Apple target, Zig's libc headers
            // don't cover Apple's Darwin extensions (sys/types.h etc.)
            // that erl_nif.h transitively requires via cImport. Add the
            // SDK's usr/include + System/Library/Frameworks to every
            // module that touches Apple-specific cImports.
            //
            // We attach to `erl_nif` specifically because it's the only
            // standard Zigler module that cImports a header pulling
            // system types. extra_modules with their own cImports would
            // need similar treatment if they hit the same issue.
            if (apple_sdkroot.len > 0) {
                erl_nif.addSystemIncludePath(.{ .cwd_relative = b.fmt("{s}/usr/include", .{apple_sdkroot}) });
            }

            // Make build_options visible to nif_shim (which contains
            // module.zig's `export fn nif_init`). The shim conditionally
            // emits an aliased @export when `nif_init_alias` is set —
            // see module.zig for the consumer.
            nif_shim.addImport("build_options", build_options.createModule());

            const lib = b.addLibrary(.{
                .name = "<%= @module %>",
                .linkage = nif_linkage,
                .version = .{.major = <%= @version.major %>,
                             .minor = <%= @version.minor %>,
                             .patch = <%= @version.patch %>},
                .root_module = nif_shim
            });

            <%= render_c(@c, :lib) %>
            <%= for extra_module <- @extra_modules, do: render_c(extra_module, :lib) %>

            // Static archives can't have unresolved symbols deferred to
            // load-time (that's a shared-library concept). Skip the flag
            // when the user requested a staticlib — the linker that
            // eventually consumes the .a will resolve the `enif_*` etc.
            if (nif_linkage == .dynamic) {
                lib.linker_allow_shlib_undefined = true;
            }

            // the native backend still causes segfaults, so we must disable it for now.
            lib.use_llvm = true;

            // Only for 32-bit x86 targets
            if (resolved_target.result.cpu.arch == .x86) {
                lib.link_z_notext = true; // passes -z notext to the linker
            }

            <%= if @libc_txt do %>
            lib.setLibCFile(b.path("<%= @libc_txt %>"));
            <% end %>

            b.installArtifact(lib);
        },
        .sema => {
            <%= Builder.render_build(BuildModule.stub_erl_nif()) %>
            <%= Builder.render_build(BuildModule.beam()) %>
            <%= Builder.render_build(BuildModule.attributes()) %>
            <%= for extra_module <- @extra_modules, do: Builder.render_build(extra_module)%>
            <%= Builder.render_build(BuildModule.from_beam_module(assigns)) %>
            <%= Builder.render_build(BuildModule.sema()) %>

            const sema_exe = b.addExecutable(.{
                .name = "sema",
                .root_module = sema
            });

            <%= render_c(@c, :sema_exe) %>
            <%= for extra_module <- @extra_modules, do: render_c(extra_module, :sema_exe) %>

            b.installArtifact(sema_exe);

            const sema_run_cmd = b.addRunArtifact(sema_exe);
            if (b.args) |args| sema_run_cmd.addArgs(args);
            const sema_step = b.step("sema", "Run sema");
            sema_step.dependOn(&sema_run_cmd.step);
        }
    }
}

fn getenvAlloc(alloc: std.mem.Allocator, name: []const u8) ?[]u8 {
    return std.process.getEnvVarOwned(alloc, name) catch null;
}
